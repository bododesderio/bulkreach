# Frontend environment (Next.js)

# Canonical public origin — drives SEO metadataBase, canonical URLs, Open Graph
# URLs, sitemap.xml, and robots.txt. Full origin, no trailing slash.
NEXT_PUBLIC_SITE_URL=https://bulkreach.ug

# Server-side base URL the RSC layer uses to reach the backend API directly
# (the browser /api proxy is not available server-side). Include the /api suffix.
API_PROXY_URL=http://localhost:3101/api
