# BulkReach — production environment. Copy to .env.production and fill in.
# docker-compose.prod.yml reads this file. NEVER commit the real .env.production.

# ── Security (REQUIRED — generate; see SECRETS.md) ───────────────────────────
SECRET_KEY=                      # ≥32 chars; JWT signing. openssl rand -hex 32
PAYMENTS_ENCRYPTION_KEY=         # Fernet key; encrypts provider creds at rest.
                                 # Required in production (fail-closed at startup).
ANON_PEPPER=                     # HMAC pepper for contact anonymisation. rand -hex 32

# ── Datastore credentials (REQUIRED — compose fails to start if unset) ───────
# docker-compose.prod.yml references these as ${VAR:?...}: an empty value aborts
# `up` rather than silently booting with a weak default. Generate strong values.
POSTGRES_PASSWORD=              # openssl rand -hex 24
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=           # openssl rand -hex 24

# ── Public URLs / networking ─────────────────────────────────────────────────
# Routed by the shared Traefik edge: bulkreach.ug → web, api.bulkreach.ug → api,
# admin.bulkreach.ug → web (Basic-Auth gated). No host ports are published.
FRONTEND_URL=https://bulkreach.ug
BASE_URL=https://api.bulkreach.ug
PAYMENTS_CALLBACK_BASE_URL=https://api.bulkreach.ug   # provider webhooks post here
TRUSTED_PROXY_COUNT=1            # client → Traefik → container = 1 trusted hop

# ── Edge Basic Auth (Traefik) ────────────────────────────────────────────────
# Gate admin.bulkreach.ug and api.bulkreach.ug/docs. Format: user:APR1_HASH.
# Generate (keep the single-quotes so the shell doesn't eat the $):
#   printf '%s:%s\n' admin "$(openssl passwd -apr1 'STRONG_PASS')"
ADMIN_BASICAUTH=                 # e.g. admin:$apr1$xxxx....
DOCS_BASICAUTH=                  # e.g. docs:$apr1$yyyy....

# ── Email (transactional + campaigns) ────────────────────────────────────────
DEFAULT_FROM_EMAIL=noreply@bulkreach.ug
DEFAULT_FROM_NAME=BulkReach
MAILGUN_DOMAIN=mg.bulkreach.ug
MAILGUN_SMTP_USER=
MAILGUN_SMTP_PASSWORD=
MAILGUN_API_KEY=

# ── SMS (Africa's Talking primary; Twilio/Infobip/Vonage optional) ───────────
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=BulkReach

# ── Payments ─────────────────────────────────────────────────────────────────
# Live provider credentials are entered by a superadmin in /admin/settings/payments
# (stored Fernet-encrypted with PAYMENTS_ENCRYPTION_KEY). These envs are only the
# fallbacks / webhook secrets when configured via env instead of the admin UI.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

# ── Analytics / storage (defaults target the compose services — leave as is) ──
# CLICKHOUSE_* and S3_* are set by docker-compose.prod.yml to the internal
# service names; override only if you use managed ClickHouse / real AWS S3.

# ── Observability (optional — blank disables each) ───────────────────────────
SENTRY_DSN=                      # FastAPI error tracking (backend). Blank → off.
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_DSN=          # Next.js browser + server error tracking. Blank → off.
KUMA_PUSH_URL=                   # Uptime-Kuma push URL for the ARQ worker heartbeat.

# ── Backups (scripts/backup.sh) ──────────────────────────────────────────────
BACKUP_KEEP_DAYS=14              # local retention before pruning
# OFFSITE_S3_BUCKET=             # optional: aws s3 sync target for off-site copies
