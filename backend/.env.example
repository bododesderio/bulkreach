# --- Core --- (generate SECRET_KEY with: openssl rand -hex 32)
ENVIRONMENT=development
SECRET_KEY=change_me_to_a_random_32_byte_hex_value_openssl_rand_hex_32
FRONTEND_URL=http://localhost:3100
BASE_URL=http://localhost:3101

# --- Databases ---
DATABASE_URL=postgresql+asyncpg://bulkreach:pw@localhost:5432/bulkreach
ARCHIVE_DATABASE_URL=postgresql+asyncpg://bulkreach:pw@localhost:3110/bulkreach_archive

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- ClickHouse ---
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=3112
CLICKHOUSE_ARCHIVE_HOST=localhost
CLICKHOUSE_ARCHIVE_PORT=3114

# --- Email (Mailgun) ---
MAILGUN_API_KEY=key-xxxx
MAILGUN_DOMAIN=mg.bulkreach.ug
MAILGUN_SMTP_USER=postmaster@mg.bulkreach.ug
MAILGUN_SMTP_PASSWORD=

# --- SMS (Africa's Talking) ---
AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER_ID=BulkReach

# --- Payments (Flutterwave) ---
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

# --- Object storage (MinIO dev) ---
S3_ENDPOINT_URL=http://localhost:3120
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET=bulkreach-uploads
S3_ARCHIVE_BUCKET=bulkreach-archive
S3_GLACIER_BUCKET=bulkreach-glacier

# --- Archive subsystem ---
ARCHIVE_INGESTION_HOUR=2
ARCHIVE_LIVE_RETENTION_MONTHS=6
